VITE_SANITY_PROJECT_ID=p3ihfsxq
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-02-19

# Sanity Studio reads these public identifiers. No token is needed for Studio login.
SANITY_STUDIO_PROJECT_ID=p3ihfsxq
SANITY_STUDIO_DATASET=production

# Server-only admin configuration. Never prefix secrets with VITE_.
SANITY_PROJECT_ID=p3ihfsxq
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
SANITY_WRITE_TOKEN=
ADMIN_ALLOWED_EMAILS=owner@example.com
ADMIN_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public form CAPTCHA (Cloudflare Turnstile, free)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Inquiry storage (Supabase). Server-only, never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public catalogue reads. The anon key is public by design; RLS returns
# published content only. Leave VITE_CONTENT_SOURCE on sanity to keep Sanity.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CONTENT_SOURCE=sanity

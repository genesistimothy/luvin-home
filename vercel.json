{
  "redirects": [
    {"source": "/produk", "destination": "/products", "permanent": true},
    {"source": "/produk/:slug", "destination": "/products/:slug", "permanent": true},
    {"source": "/layanan", "destination": "/services", "permanent": true},
    {"source": "/layanan/:slug", "destination": "/services/:slug", "permanent": true},
    {"source": "/proyek", "destination": "/projects", "permanent": true},
    {"source": "/proyek/:slug", "destination": "/projects/:slug", "permanent": true},
    {"source": "/kontak", "destination": "/contact", "permanent": true}
  ],
  "rewrites": [
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}

{
  "name": "luvin-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src sanity api tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "studio": "cd sanity && sanity dev",
    "studio:build": "cd sanity && sanity build dist --yes",
    "studio:deploy": "cd sanity && sanity deploy",
    "cms:migrate": "cd sanity && sanity exec migrations/importExistingContent.mjs --with-user-token"
  },
  "dependencies": {
    "@sanity/client": "^7.23.1",
    "@sanity/image-url": "^2.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
